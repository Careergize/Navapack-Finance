# Copy to .env.local; never commit the local file.
CUSTOM_IMAGE=navapack-finance
CUSTOM_TAG=16.53.0-frappe16.55.1-local
ERPNEXT_VERSION=v16.53.0
PULL_POLICY=never
RESTART_POLICY=unless-stopped
FRAPPE_SITE_NAME_HEADER=finance.localhost
DB_PASSWORD=REPLACE_WITH_RANDOM_HEX
ADMIN_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_HEX
# Set exact repository@sha256 references during Lock phase.
MARIADB_IMAGE=UNRESOLVED
REDIS_IMAGE=UNRESOLVED
